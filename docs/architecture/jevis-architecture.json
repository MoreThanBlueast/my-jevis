  "cards": [
    {
      "dot": "cyan",
      "title": "隔离保证",
      "items": [
        "目标 App 只启动在 scrcpy 虚拟显示（Display N > 0）",
        "执行器校验 displayId 与 profileUserId，绝不回退主屏",
        "白名单仅 8 个目标 App，越界直接拒绝"
      ]
    },
    {
      "dot": "rose",
      "title": "人工闸门",
      "items": [
        "confirmation_policy = BEFORE_EXTERNAL_ACTION",
        "对外副作用必须先生成审批，approve 后才执行",
        "拒绝或取消立即终止，执行器停止接受新动作"
      ]
    },
    {
      "dot": "amber",
      "title": "已知薄弱点",
      "items": [
        "scrcpy 与后端进程无健康自检，任一消失任务会静默卡住",
        "规划器可能因模型返回非标准 JSON 停在 NEEDS_REVIEW",
        "同任务发送去重已实现，需重装 App 后生效"
      ]
    }
  ]
